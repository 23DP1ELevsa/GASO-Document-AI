{
  "name": "gaso-document-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "android:sync": "vite build --mode native && cap sync android",
    "android:open": "cap open android",
    "android:run": "npm run android:sync && cap run android",
    "android:build": "npm run android:sync && node scripts/build-android.mjs",
    "assets": "node scripts/generate-icons.mjs",
    "test:e2e": "playwright test",
    "test:unit": "node --test tests-unit/*.test.js",
    "android:check": "node scripts/verify-android.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/splash-screen": "^8.0.2",
    "@lucide/vue": "^1.71.0",
    "vue": "^3.5.45",
    "vue-router": "^4.6.0",
    "vuetify": "~3.13.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@capacitor/cli": "^8.6.0",
    "@playwright/test": "^1.65.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "prettier": "^3.9.10",
    "sharp": "^0.34.0",
    "vite": "^8.3.7",
    "vite-plugin-pwa": "^2.0.0",
    "workbox-window": "^7.4.1"
  }
}
