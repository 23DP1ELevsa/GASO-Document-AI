{
  "name": "gaso/meter-prototype",
  "type": "project",
  "require": {"php": "^8.3", "laravel/framework": "^12.0", "ext-gd": "*", "ext-exif": "*"},
  "require-dev": {"phpunit/phpunit": "^11.5"},
  "autoload": {"psr-4": {"App\\": "app/"}},
  "autoload-dev": {"psr-4": {"Tests\\": "tests/"}},
  "scripts": {"test": "@php -d memory_limit=512M vendor/phpunit/phpunit/phpunit", "post-autoload-dump": ["Illuminate\\Foundation\\ComposerScripts::postAutoloadDump"]},
  "config": {"sort-packages": true, "allow-plugins": {}, "platform": {"php": "8.3.30"}}
}
