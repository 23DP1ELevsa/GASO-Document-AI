APP_NAME="GASO Document AI"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000
APP_LOCALE=lv
APP_FALLBACK_LOCALE=en
LOG_CHANNEL=single
LOG_LEVEL=info
CACHE_STORE=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
# Use true with HTTPS. Local loopback tasks use HTTP.
SESSION_SECURE_COOKIE=false
AUTH_SESSION_MAX_MINUTES=480
AUTH_TOKEN_MINUTES=60
AUTH_EMAIL_DOMAIN=gaso.lv
AUTH_EMAIL_LOCAL_PATTERN='/^[a-z]+(?:-[a-z]+)*[.][a-z]+(?:-[a-z]+)*$/D'
QUEUE_CONNECTION=sync

#AI
DOCUMENT_AI_PROVIDER=openai
DOCUMENT_AI_ENABLED=true

OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

OPENAI_TIMEOUT=60
DOCUMENT_AI_MAX_OUTPUT_TOKENS=4000
DOCUMENT_AI_REQUESTS_PER_MINUTE=3
DOCUMENT_AI_USER_REQUESTS_PER_MINUTE=3
DOCUMENT_AI_TEST_REQUEST_LIMIT=20

# Reserved for a future approved corporate provider; unused by this integration.
CORPORATE_AI_BASE_URL=
CORPORATE_AI_API_KEY=
CORPORATE_AI_MODEL=
CORPORATE_AI_TIMEOUT=60

# Optional local document storage
DOCUMENT_STORAGE_ENABLED=false
DOCUMENT_STORAGE_DRIVER=mongodb
MONGODB_URI=
MONGODB_DATABASE=gaso_document_ai
